<Window x:Class="FloatTodo.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FloatTodo 提醒" Width="330" Height="175"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual">
    <Border Background="#FFFCFDFF" CornerRadius="15" BorderThickness="1" BorderBrush="#FFCEDCF2" Padding="15">
        <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.22"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="×" Width="24" Height="24" Padding="1"
                        Click="Dismiss_Click" ToolTip="关闭提醒，不视为完成"/>
                <TextBlock x:Name="HeadingLabel" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
            </DockPanel>
            <TextBlock x:Name="DetailsLabel" Grid.Row="1" TextWrapping="Wrap" Margin="0,12,0,8"
                       Foreground="{StaticResource Ink}" FontSize="13"/>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button x:Name="SnoozeButton" Grid.Column="0" Content="10 分钟后" Click="Snooze_Click"/>
                <Button x:Name="CompleteButton" Grid.Column="2" Content="完成任务 ✓" Click="Complete_Click"
                        Background="#FF577DF0" Foreground="White"/>
            </Grid>
        </Grid>
    </Border>
</Window>
