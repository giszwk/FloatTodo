<Window x:Class="FloatTodo.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FloatTodo 设置" Width="395" Height="305"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow" ShowInTaskbar="False" Topmost="True">
    <Grid Margin="22">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="悬浮球设置" FontSize="18" FontWeight="SemiBold"
                   Foreground="{StaticResource Ink}" Margin="0,0,0,16" Grid.ColumnSpan="2" />
        <TextBlock Grid.Row="1" Text="吸附距离（像素，8–120）" VerticalAlignment="Center" Margin="0,0,0,12"/>
        <TextBox x:Name="DistanceBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" />
        <TextBlock Grid.Row="2" Text="半隐藏露出比例（20–80%）" VerticalAlignment="Center" Margin="0,0,0,12"/>
        <TextBox x:Name="VisibleBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,12" />
        <TextBlock Grid.Row="3" Text="移出后收起延迟（100–2000ms）" VerticalAlignment="Center"/>
        <TextBox x:Name="DelayBox" Grid.Row="3" Grid.Column="1" />
        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,20,0,0"
                   FontSize="11" Foreground="{StaticResource Muted}"
                   Text="数据全部保存在本机 %LOCALAPPDATA%\FloatTodo。暂不接入账号或云端服务。"/>
        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Content="取消" MinWidth="76" IsCancel="True" Margin="0,0,10,0"/>
            <Button Content="保存" MinWidth="76" Click="Save_Click"
                    Background="#FF577DF0" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
