<Window x:Class="FloatTodo.TasksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="待办事项" Width="385" Height="485" Opacity="0"
        AllowsTransparency="True" Background="Transparent"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True" WindowStartupLocation="Manual">
    <Border Background="#FFFCFDFF" BorderBrush="#FFD7E3F3" BorderThickness="1"
            CornerRadius="18" Padding="16">
        <Border.Effect>
            <DropShadowEffect Color="#FF425A84" ShadowDepth="3" BlurRadius="15" Opacity="0.23"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="125"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,13">
                <TextBlock Text="今天要做什么？" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource Ink}"/>
                <TextBlock x:Name="ProgressLabel" Text="" Margin="10,5,0,0"
                           FontSize="12" Foreground="{StaticResource Muted}" />
            </DockPanel>
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NewTaskBox" Grid.Column="0" Height="37"
                         MaxLength="200" FontSize="13" ToolTip="输入任务后按 Enter"
                         KeyDown="NewTaskBox_KeyDown" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Content="+ 新建" Click="Add_Click"
                        Foreground="White" FontWeight="SemiBold" Background="#FF577DF0"/>
            </Grid>
            <DockPanel Grid.Row="2" Margin="0,0,0,8">
                <TextBlock Text="待办事项" FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource Ink}" />
                <TextBlock x:Name="PendingLabel" Margin="8,0,0,0" FontSize="12"
                           Foreground="{StaticResource Muted}" />
            </DockPanel>
            <Grid Grid.Row="3">
                <TextBlock x:Name="PendingEmpty" Text="还没有任务，新增一项吧。"
                           Foreground="{StaticResource Muted}" FontSize="12"
                           VerticalAlignment="Top" Margin="4,12"/>
                <ScrollViewer x:Name="PendingScroller" VerticalScrollBarVisibility="Auto" PreviewDragOver="ListScroller_PreviewDragOver">
                    <ItemsControl x:Name="PendingList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFF1F5FC" CornerRadius="9"
                                        BorderBrush="Transparent" BorderThickness="1"
                                        AllowDrop="True" DragOver="TaskRow_DragOver"
                                        DragLeave="TaskRow_DragLeave" Drop="TaskRow_Drop"
                                        Padding="7,4" Margin="0,0,3,7">
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right" Content="×" MinHeight="26"
                                                Width="28" Padding="2" Margin="5,0,0,0"
                                                Tag="{Binding Id}" Click="Delete_Click" ToolTip="删除" />
                                        <Button DockPanel.Dock="Right" Content="编辑" MinHeight="26"
                                                Padding="7,2" Tag="{Binding Id}"
                                                Click="Edit_Click" />
                                        <Border DockPanel.Dock="Left" Width="23" Height="27"
                                                Background="Transparent" Cursor="SizeAll"
                                                ToolTip="按住拖动以调整顺序"
                                                PreviewMouseLeftButtonDown="DragHandle_MouseDown"
                                                PreviewMouseMove="DragHandle_MouseMove"
                                                PreviewMouseLeftButtonUp="DragHandle_MouseUp">
                                            <TextBlock Text="⠿" FontSize="19" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="#FF92A2BC"/>
                                        </Border>
                                        <CheckBox Content="{Binding Title}" Tag="{Binding Id}"
                                                  VerticalAlignment="Center" FontSize="13"
                                                  Foreground="{StaticResource Ink}"
                                                  Checked="Complete_Checked"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
            <DockPanel Grid.Row="4" Margin="0,12,0,8">
                <TextBlock Text="已完成" FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource Ink}"/>
                <TextBlock x:Name="CompletedLabel" Margin="8,0,0,0" FontSize="12"
                           Foreground="{StaticResource Muted}" />
            </DockPanel>
            <Grid Grid.Row="5">
                <TextBlock x:Name="CompletedEmpty" Text="暂无已完成事项。"
                           Foreground="{StaticResource Muted}" FontSize="12"
                           Margin="4,12" VerticalAlignment="Top" />
                <ScrollViewer x:Name="CompletedScroller" VerticalScrollBarVisibility="Auto" PreviewDragOver="ListScroller_PreviewDragOver">
                    <ItemsControl x:Name="CompletedList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFF7F9FB" CornerRadius="9"
                                        BorderBrush="Transparent" BorderThickness="1"
                                        AllowDrop="True" DragOver="TaskRow_DragOver"
                                        DragLeave="TaskRow_DragLeave" Drop="TaskRow_Drop"
                                        Padding="7,4" Margin="0,0,3,7">
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right" Content="×" MinHeight="26"
                                                Width="28" Padding="2" Margin="5,0,0,0"
                                                Tag="{Binding Id}" Click="Delete_Click" ToolTip="删除"/>
                                        <Button DockPanel.Dock="Right" Content="编辑" MinHeight="26"
                                                Padding="7,2" Tag="{Binding Id}" Click="Edit_Click" />
                                        <Border DockPanel.Dock="Left" Width="23" Height="27"
                                                Background="Transparent" Cursor="SizeAll"
                                                ToolTip="按住拖动以调整顺序"
                                                PreviewMouseLeftButtonDown="DragHandle_MouseDown"
                                                PreviewMouseMove="DragHandle_MouseMove"
                                                PreviewMouseLeftButtonUp="DragHandle_MouseUp">
                                            <TextBlock Text="⠿" FontSize="19" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="#FF92A2BC"/>
                                        </Border>
                                        <CheckBox Content="{Binding Title}" IsChecked="True"
                                                  Tag="{Binding Id}" FontSize="12"
                                                  Foreground="{StaticResource Muted}"
                                                  VerticalAlignment="Center" Unchecked="Reopen_Unchecked" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
            <TextBlock Grid.Row="6" Margin="2,12,0,0" FontSize="10.5"
                       Foreground="{StaticResource Muted}"
                       Text="拖动左侧手柄排序 · 勾选完成 · 鼠标移出收起" />
        </Grid>
    </Border>
</Window>
