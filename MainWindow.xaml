<Window x:Class="FloatTodo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FloatTodo.Views"
        Title="FloatTodo" Width="64" Height="64"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual" Topmost="True"
        MouseEnter="Ball_MouseEnter" MouseLeave="Ball_MouseLeave">
    <Grid x:Name="BallRoot" Cursor="Hand" Background="Transparent"
          MouseLeftButtonDown="Ball_MouseLeftButtonDown"
          MouseLeftButtonUp="Ball_MouseLeftButtonUp"
          MouseMove="Ball_MouseMove">
        <views:BallVisual x:Name="BallVisual"/>
        <views:CatSkinVisual x:Name="CatVisual" Visibility="Collapsed"/>
    </Grid>
</Window>
