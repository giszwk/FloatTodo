<UserControl x:Class="FloatTodo.Views.CatSkinVisual"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="96" Height="96" Background="Transparent">
    <Grid Width="96" Height="96">
        <!-- 猫咪仅使用位图图片或 GIF 帧；不再使用矢量路径绘制。 -->
        <Grid x:Name="FullArtwork" Width="96" Height="96" IsHitTestVisible="False">
            <Image x:Name="FullImage" Width="96" Height="96" Stretch="Uniform"
                   Source="/FloatTodo;component/Assets/Skins/cat-visible.png">
                <Image.RenderTransform><TranslateTransform x:Name="FullImageMove" /></Image.RenderTransform>
            </Image>
        </Grid>
        <Grid x:Name="PeekArtwork" Width="96" Height="96" Visibility="Collapsed" IsHitTestVisible="False"
              RenderTransformOrigin=".5,.5">
            <Grid.RenderTransform>
                <!-- 沿竖直轴镜像；不做上下颠倒或额外平移。 -->
                <ScaleTransform x:Name="PeekScale" ScaleX="1" />
            </Grid.RenderTransform>
            <!-- 图片的透明边距较大；缩放并向外偏移，使窗口仅露出 40% 时仍能看到脸与爪子。 -->
            <Image x:Name="PeekImage" Width="54" Height="72" Stretch="Uniform"
                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-12,0,0,0"
                   Source="/FloatTodo;component/Assets/Skins/cat-peek.png" />
        </Grid>
        <Border x:Name="CountBadge" Background="#FFFD6C78" CornerRadius="10"
                MinWidth="19" Height="19" Padding="4,0" HorizontalAlignment="Right"
                VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="CountText" Foreground="White" FontSize="10" FontWeight="Bold"
                       TextAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
