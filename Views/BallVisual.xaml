<UserControl x:Class="FloatTodo.Views.BallVisual"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <!-- 后续动漫角色/皮肤替换此 UserControl 即可，无需修改悬浮窗的拖拽与吸边逻辑。 -->
    <Grid Width="64" Height="64">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>
        <Ellipse Margin="3" Stroke="#8BE0F9" StrokeThickness="1.5">
            <Ellipse.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF73D6FD" Offset="0" />
                    <GradientStop Color="#FF567EF3" Offset="1" />
                </LinearGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <DropShadowEffect Color="#FF446AC8" BlurRadius="11" ShadowDepth="3" Opacity="0.37" />
            </Ellipse.Effect>
        </Ellipse>
        <TextBlock Text="✓" Foreground="White" FontFamily="Segoe UI Symbol"
                   FontWeight="Bold" FontSize="30" HorizontalAlignment="Center"
                   VerticalAlignment="Center" Margin="0,-3,0,0" IsHitTestVisible="False" />
        <Border x:Name="CountBadge" Background="#FFFD6C78" CornerRadius="10"
                MinWidth="19" Height="19" Padding="4,0" HorizontalAlignment="Right"
                VerticalAlignment="Top" Margin="0,-1,-1,0" Visibility="Collapsed"
                IsHitTestVisible="False">
            <TextBlock x:Name="CountText" Foreground="White" FontSize="10"
                       TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
        </Border>
    </Grid>
</UserControl>
